<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap">

  <Identity Name="PokeSilverUWP" Publisher="CN=PokeSilverUWP" Version="1.0.0.0" />

  <Properties>
    <DisplayName>Pokemon Silver</DisplayName>
    <PublisherDisplayName>PokeSilverUWP</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="PokeSilver.App">
      <uap:VisualElements
        DisplayName="Pokemon Silver"
        Description="Pokemon Silver, built from the pokegold disassembly, running on an embedded Game Boy Color core."
        BackgroundColor="#464e5c"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#464e5c" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
